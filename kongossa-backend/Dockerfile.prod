FROM node:20-alpine AS builder
WORKDIR /app

# Install PostgreSQL client tools for backups
RUN apk add --no-cache postgresql16-client

COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

COPY . .

# Generate AFTER copying the source. If the build context carries a host
# node_modules (it does on the production server, where Dockerfile.local needs
# one), `COPY . .` overwrites the client generated before it — leaving a stale
# client that does not match schema.prisma, and the TypeScript build then fails
# on models like AgentProfile.
#
# `prisma generate` never opens a database connection — it only reads
# schema.prisma to emit the client — but prisma.config.ts validates
# DATABASE_URL via env() at config-load time, which now runs for `generate`
# too, not just `migrate`. The real URL only exists at runtime (from
# docker-compose), so hand generate a syntactically valid placeholder here.
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN npx prisma generate --schema=./prisma/schema.prisma
RUN npm run build

FROM node:20-alpine
WORKDIR /app

# Install PostgreSQL client tools in production image for backups
RUN apk add --no-cache postgresql16-client

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma

RUN mkdir -p /app/uploads && chmod 755 /app/uploads

EXPOSE 3000

CMD ["node", "dist/main.js"]