FROM node:20-alpine AS builder
WORKDIR /app

# Install PostgreSQL client tools for backups
RUN apk add --no-cache postgresql16-client

COPY package*.json ./
COPY prisma ./prisma/

RUN npm ci

COPY . .

# Generate AFTER copying the source. If the build context carries a host
# node_modules (it does on the production server, where Dockerfile.local needs
# one), `COPY . .` overwrites the client generated before it — leaving a stale
# client that does not match schema.prisma, and the TypeScript build then fails
# on models like AgentProfile.
RUN npx prisma generate --schema=./prisma/schema.prisma
RUN npm run build

FROM node:20-alpine
WORKDIR /app

# Install PostgreSQL client tools in production image for backups
RUN apk add --no-cache postgresql16-client

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/prisma ./prisma

RUN mkdir -p /app/uploads && chmod 755 /app/uploads

EXPOSE 3000

CMD ["node", "dist/main.js"]