# Production environment template.
#
# Copy to `.env` on the server and fill in real values there. NEVER commit real
# values to this file — it is tracked in git.
#
# NOTE: an earlier revision of this file contained a live Gmail app password.
# That credential must be treated as compromised: revoke it in the Google
# account and issue a new one. It remains visible in git history until the
# history is rewritten.

# Database
DB_PASSWORD={{DB_PASSWORD}}

# JWT
JWT_SECRET={{JWT_SECRET}}

# Stripe
STRIPE_SECRET_KEY={{STRIPE_SECRET_KEY}}
STRIPE_WEBHOOK_SECRET={{STRIPE_WEBHOOK_SECRET}}

# SMTP
SMTP_EMAIL={{SMTP_EMAIL}}
SMTP_PASSWORD={{SMTP_PASSWORD}}
