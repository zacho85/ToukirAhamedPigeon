# Sandbox environment template.
#
# Copy to `.env.sandbox` on the server and fill in real values there.
# `.env.sandbox` is gitignored — never commit real values to this template.
#
# Every secret here MUST differ from its production counterpart. That is what
# makes a production token useless against sandbox, and a sandbox token useless
# against production.

# --- Database (sandbox only) ---
SANDBOX_DB_USER=kongossa_sandbox
SANDBOX_DB_PASSWORD={{SANDBOX_DB_PASSWORD}}

# --- JWT (MUST NOT match production) ---
# Generate with: openssl rand -hex 48
SANDBOX_JWT_SECRET={{SANDBOX_JWT_SECRET}}
SANDBOX_JWT_REFRESH_SECRET={{SANDBOX_JWT_REFRESH_SECRET}}

# --- Stripe TEST mode only ---
# Keys must begin with the test-mode prefix, never the live one.
SANDBOX_STRIPE_SECRET_KEY={{SANDBOX_STRIPE_TEST_SECRET_KEY}}
SANDBOX_STRIPE_PUBLISHABLE_KEY={{SANDBOX_STRIPE_TEST_PUBLISHABLE_KEY}}
SANDBOX_STRIPE_WEBHOOK_SECRET={{SANDBOX_STRIPE_TEST_WEBHOOK_SECRET}}
SANDBOX_STRIPE_PAYMENT_LINKS_WEBHOOK_SECRET={{SANDBOX_STRIPE_TEST_PAYMENT_LINKS_WEBHOOK_SECRET}}

# --- Other payment providers ---
# Leave unset unless the provider offers a true sandbox. An unset credential
# makes that provider fail loudly, which is the desired behaviour here.
# MOMO_COLLECTION_PRIMARY_KEY=
# MOMO_COLLECTION_USER_ID=
# MOMO_COLLECTION_API_KEY=
# ORANGE_MONEY_AUTH_HEADER=
# ORANGE_MONEY_MERCHANT_KEY=
# TRANSFI_BASE_URL=
# TRANSFI_USERNAME=
# TRANSFI_PASSWORD=
# TRANSFI_MERCHANT_ID=

# --- M-Pesa Daraja (sandbox app from developer.safaricom.co.ke) ---
# MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# STK Push callback: <public API URL>/wallet-topup/mpesa/webhook
# MPESA_CALLBACK_URL=
# C2B paybill: shortcode and the public API base URL the C2B URLs are built on.
# MPESA_C2B_SHORTCODE=
# MPESA_C2B_BASE_URL=

# --- Seed account handed to the external developer ---
# Used by prisma/seed.sandbox.ts. Change it before sharing.
SANDBOX_DEV_EMAIL=mobile.dev@sandbox.kongossapay.com
SANDBOX_DEV_PASSWORD={{SANDBOX_DEV_PASSWORD}}
SANDBOX_ADMIN_EMAIL=admin@sandbox.kongossapay.com
SANDBOX_ADMIN_PASSWORD={{SANDBOX_ADMIN_PASSWORD}}
